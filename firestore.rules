rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny rule
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Hardened Global Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validation Blueprints ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'fullName', 'email'])
        && data.keys().size() <= 8
        && data.uid is string && data.uid.size() <= 128
        && data.fullName is string && data.fullName.size() <= 200
        && data.email is string && data.email.size() <= 200
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 1000000))
        && (!('providerId' in data) || (data.providerId is string && data.providerId.size() <= 100))
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidVisit(data) {
      return data.keys().hasAll(['visitorId'])
        && data.keys().size() <= 6
        && data.visitorId is string && data.visitorId.size() <= 128
        && (!('userId' in data) || data.userId is string || data.userId == null)
        && (!('email' in data) || data.email is string || data.email == null)
        && (!('providerId' in data) || data.providerId is string || data.providerId == null)
        && (!('userAgent' in data) || data.userAgent is string || data.userAgent == null)
        && (!('createdAt' in data) || data.createdAt is timestamp);
    }

    function isValidResume(data) {
      return data.keys().hasAll(['userId', 'personal', 'selectedTemplate', 'selectedColor'])
        && data.keys().size() <= 20
        && data.userId is string && data.userId.size() <= 128
        && data.userId == request.auth.uid
        && data.selectedTemplate is string && data.selectedTemplate.size() <= 50
        && data.selectedColor is string && data.selectedColor.size() <= 50
        && (!('selectedFont' in data) || (data.selectedFont is string && data.selectedFont.size() <= 100))
        && (!('selectedDensity' in data) || (data.selectedDensity is string && data.selectedDensity.size() <= 50))
        && (!('selectedLayoutVariation' in data) || (data.selectedLayoutVariation is string && data.selectedLayoutVariation.size() <= 50))
        && (!('selectedBulletStyle' in data) || (data.selectedBulletStyle is string && data.selectedBulletStyle.size() <= 50))
        && (!('selectedBorderAccent' in data) || (data.selectedBorderAccent is string && data.selectedBorderAccent.size() <= 50))
        && (!('showAvatar' in data) || (data.showAvatar is bool))
        && (!('selectedAvatarShape' in data) || (data.selectedAvatarShape is string && data.selectedAvatarShape.size() <= 50))
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp)
        && data.personal is map
        && data.personal.keys().hasAll(['fullName'])
        && data.personal.fullName is string && data.personal.fullName.size() <= 200
        && (!('jobTitle' in data.personal) || (data.personal.jobTitle is string && data.personal.jobTitle.size() <= 200))
        && (!('email' in data.personal) || (data.personal.email is string && data.personal.email.size() <= 200))
        && (!('phone' in data.personal) || (data.personal.phone is string && data.personal.phone.size() <= 100))
        && (!('address' in data.personal) || (data.personal.address is string && data.personal.address.size() <= 500))
        && (!('linkedin' in data.personal) || (data.personal.linkedin is string && data.personal.linkedin.size() <= 500))
        && (!('website' in data.personal) || (data.personal.website is string && data.personal.website.size() <= 500))
        && (!('summary' in data.personal) || (data.personal.summary is string && data.personal.summary.size() <= 2000))
        && (!('photoUrl' in data.personal) || (data.personal.photoUrl is string && data.personal.photoUrl.size() <= 1000000))
        && data.education is list
        && data.experience is list
        && data.skills is list
        && data.projects is list
        && data.certifications is list
        && data.languages is list;
    }

    function isValidReview(data, isSystemAdmin) {
      return data.keys().hasAll(['userId', 'fullName', 'email', 'rating', 'reviewText'])
        && data.keys().size() <= 7
        && data.userId is string && data.userId.size() <= 128
        && (isSystemAdmin || data.userId == request.auth.uid)
        && data.fullName is string && data.fullName.size() <= 200
        && data.email is string && data.email.size() <= 200
        && (isSystemAdmin || data.email == request.auth.token.email)
        && (data.rating is int || data.rating is float) && data.rating >= 1 && data.rating <= 5
        && data.reviewText is string && data.reviewText.size() >= 2 && data.reviewText.size() <= 2000
        && (!('createdAt' in data) || data.createdAt is timestamp);
    }

    function isValidSupportMessage(data) {
      return data.keys().hasAll(['userId', 'name', 'email', 'message'])
        && data.keys().size() <= 7
        && data.userId is string && data.userId.size() <= 128
        && data.name is string && data.name.size() <= 200
        && data.email is string && data.email.size() <= 200
        && data.message is string && data.message.size() >= 2 && data.message.size() <= 5000
        && (!('reply' in data) || (data.reply is string && data.reply.size() <= 5000))
        && (!('repliedAt' in data) || data.repliedAt is timestamp)
        && (!('createdAt' in data) || data.createdAt is timestamp);
    }

    // --- Match Rules ---

    match /test/connection {
      allow read: if true;
    }

    match /reviews/{reviewId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(reviewId)
        && isValidReview(incoming(), isAdmin())
        && incoming().createdAt == request.time;
      allow update: if isSignedIn()
        && isValidId(reviewId)
        && isValidReview(incoming(), isAdmin())
        && (
          (existing().userId == request.auth.uid && incoming().userId == existing().userId && incoming().email == existing().email)
          ||
          isAdmin()
        )
        && incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn()
        && (existing().userId == request.auth.uid || isAdmin());
    }

    match /support_messages/{messageId} {
      allow create: if isSignedIn()
        && isValidId(messageId)
        && isValidSupportMessage(incoming())
        && incoming().createdAt == request.time
        && incoming().userId == request.auth.uid;
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn()
        && isValidId(messageId)
        && isValidSupportMessage(incoming())
        && (
          isAdmin()
          ||
          (existing().userId == request.auth.uid && incoming().userId == existing().userId && incoming().email == existing().email && incoming().diff(existing()).affectedKeys().hasOnly(['message']))
        );
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId)
        && isValidUser(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time;
      allow update: if isOwner(userId)
        && isValidUser(incoming())
        && incoming().uid == userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'photoUrl', 'providerId', 'updatedAt']);
      allow delete: if false;
    }

    match /resumes/{resumeId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid);
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
        && isValidId(resumeId)
        && isValidResume(incoming())
        && (!('createdAt' in incoming()) || incoming().createdAt == request.time);
      allow update: if isSignedIn()
        && isValidId(resumeId)
        && isValidResume(incoming())
        && existing().userId == request.auth.uid
        && incoming().userId == request.auth.uid
        && (!('createdAt' in existing()) || !('createdAt' in incoming()) || incoming().createdAt == existing().createdAt)
        && incoming().updatedAt == request.time;
      allow delete: if isSignedIn()
        && existing().userId == request.auth.uid;
    }

    match /visits/{visitId} {
      allow create: if isValidId(visitId) && isValidVisit(incoming()) && (incoming().createdAt == request.time || !('createdAt' in incoming()));
      allow get, list: if isAdmin();
    }
  }
}
